{
  "name": "playbound-launcher",
  "version": "0.3.21",
  "description": "PlayBound App — discover, install, update, and launch free PC games and servers.",
  "main": "bootstrap.js",
  "scripts": {
    "start": "electron .",
    "test:resolve": "electron . --test-resolve",
    "test:deep-link": "electron . --test-deep-link",
    "sync-catalog": "node scripts/sync-catalog.js",
    "test:saves": "node services/SaveData.test.js",
    "test:settings": "node services/settingsCrypto.test.js",
    "test:security": "node services/security.test.js",
    "test:deeplinks": "node services/deepLinks.test.js",
    "test:portmapping": "node services/portMapping.test.js",
    "dist": "node scripts/build-windows.js --dev",
    "dist:dev": "node scripts/build-windows.js --dev",
    "dist:prod": "node scripts/build-windows.js --prod",
    "dist:mac": "electron-builder --mac --universal",
    "verify:signatures": "node scripts/verify-signatures.js",
    "signing:status": "node scripts/signing-status.js",
    "dist:linux": "electron-builder --linux AppImage",
    "test:cache": "node renderer/cache.test.mjs",
    "test:home-ranking": "node renderer/homeRanking.test.mjs",
    "test:discovery": "node renderer/discovery.test.mjs",
    "test:connect": "node services/connectArgs.test.js",
    "test:catalog": "node services/catalogMerge.test.js",
    "test:exe-format": "node services/executableFormat.test.js",
    "test:dosbox": "node services/ManagedDosBox.test.js",
    "test:dotnet": "node services/ManagedDotNet.test.js",
    "test:retroarch": "node services/ManagedRetroArch.test.js",
    "test:steamcmd": "node services/steamCmd.test.js",
    "test:steam-prerequisites": "node services/steamPrerequisites.test.js",
    "test:controller": "node services/gameControllerConfig.test.js",
    "test:couch": "node services/couch/protocol.test.js",
    "test:runner": "node services/CompatibilityRunner.test.js",
    "test:gamelauncher": "node services/GameLauncher.test.js",
    "test:vigem": "node services/couch/windowsVigem.test.js",
    "test:elevate": "node services/GameLauncher.elevate.test.js"
  },
  "author": "PlayBound",
  "license": "MIT",
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.8.9",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
