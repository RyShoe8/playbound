{
  "name": "playbound-launcher",
  "version": "0.1.13",
  "description": "PlayBound App — discover, install, update, and launch free PC games and servers.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:resolve": "electron . --test-resolve",
    "test:deep-link": "electron . --test-deep-link",
    "dist": "electron-builder --win"
  },
  "author": "PlayBound",
  "license": "MIT",
  "build": {
    "appId": "gg.playbound.launcher",
    "productName": "PlayBound",
    "files": [
      "main.js",
      "preload.js",
      "catalog.js",
      "renderer/**/*"
    ],
    "protocols": {
      "name": "PlayBound Deep Link",
      "schemes": [
        "playbound"
      ]
    },
    "forceCodeSigning": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://mt8u2b96lweefbpb.public.blob.vercel-storage.com/launcher/"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "PlayBound-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PlayBound",
      "artifactName": "PlayBound-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PlayBound-Launcher-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
