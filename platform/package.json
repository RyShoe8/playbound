{
  "name": "playbound",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run check:auth-urls && npm run insert:catalog-wave && npm run sync:game-host",
    "start": "next start",
    "lint": "eslint",
    "load-test:polling": "tsx scripts/load-test-polling.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:games": "tsx scripts/seed-games.ts",
    "upload:launcher": "tsx scripts/upload-launcher.ts",
    "seed:mod-classifications": "tsx scripts/seed-mod-classifications.ts",
    "insert:catalog-wave": "tsx scripts/insert-catalog-wave.ts",
    "sync:game-host": "tsx scripts/sync-game-host.ts",
    "sync:edition-install": "tsx scripts/sync-edition-install.ts",
    "patch:named-mods": "tsx scripts/patch-named-mods.ts",
    "fix:mod-media": "tsx scripts/fix-mod-media.ts",
    "fetch:mod-covers": "tsx scripts/fetch-mod-covers.ts",
    "compress:static-media": "tsx scripts/compress-static-media.ts",
    "seed:developers": "tsx scripts/seed-developers.ts",
    "migrate:editions": "tsx scripts/migrate-editions.ts",
    "migrate:review-index": "tsx scripts/migrate-review-index.ts",
    "migrate:review-index:apply": "tsx scripts/migrate-review-index.ts --apply --soft-fail",
    "migrate:library-platform": "tsx scripts/migrate-library-platform.ts",
    "migrate:library-platform:apply": "tsx scripts/migrate-library-platform.ts --apply --soft-fail",
    "migrate:add-singleplayer-feature": "tsx scripts/migrate-add-singleplayer-feature.ts",
    "migrate:add-singleplayer-feature:apply": "tsx scripts/migrate-add-singleplayer-feature.ts --apply --soft-fail",
    "seed:collections": "tsx scripts/seed-collections.ts",
    "seed:weekly": "tsx scripts/seed-weekly.ts",
    "seed:hardware": "tsx scripts/seed-hardware.ts",
    "seed:store-providers": "tsx scripts/seed-store-providers.ts",
    "ingest:free-offers": "tsx scripts/ingest-free-offers.ts",
    "apply:free-text-hardware": "tsx scripts/apply-free-text-hardware.ts",
    "migrate:discussions": "tsx scripts/migrate-discussion-posts.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:maintenance": "tsx scripts/verify-maintenance.ts",
    "check:auth-urls": "tsx scripts/check-auth-urls.ts",
    "upload:artifact": "tsx scripts/upload-game-artifact.ts",
    "seed:missing-mods": "tsx scripts/seed-missing-mods.ts",
    "//seed:deploy": "MANUAL ONLY — deliberately not part of `build`. The catalog is complete, so a deploy must not write to it. Run by hand when a named game genuinely needs its seed mods created.",
    "seed:deploy": "npm run seed:missing-mods -- --games wolfenstein-enemy-territory",
    "seed:missing-games": "tsx scripts/seed-missing-games.ts",
    "seed:missing-editions": "tsx scripts/seed-missing-editions.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@base-ui/react": "^1.6.0",
    "@getbrevo/brevo": "^5.0.4",
    "@upstash/redis": "^1.38.3",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.21.0",
    "mongoose": "^9.7.3",
    "next": "16.2.12",
    "next-auth": "4.24.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/hls.js": "^0.13.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "node-unrar-js": "^2.0.2",
