+    // PlayBound isolated servers permit explicit binds only on allocated
+    // ports. Detect address-family support without reserving an unrelated
+    // ephemeral listener. The real ENet binds still validate the allocation.
+    int ipv4_probe = ::socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    int ipv6_probe = ::socket(AF_INET6, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    m_system_ipv4 = ipv4_probe >= 0;
+    m_system_ipv6 = ipv6_probe >= 0;
