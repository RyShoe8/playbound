#!/usr/bin/python3
"""Root-owned read-only scan. Never inspect command lines or environments."""
import json
import os
import sys

targets = {
    "tiberian-dawn-hd": ["tiberian-dawn-hd"],
    "crystallized-nexus": ["crystallized-nexus"],
    "romanovs-vengeance": ["romanovs-vengeance"],
    "goldeneye-source": ["goldeneye-source"],
    "deus-ex": ["deus-ex"],
    "counter-strike-2": ["counter-strike-2", "cs2"],
    "team-fortress-2": ["team-fortress-2", "open-fortress"],
    "open-fortress": ["open-fortress"],
    "unturned": ["unturned"],
    "counter-strike-source": ["counter-strike-source"],
    "core-keeper": ["core-keeper"],
    "dont-starve-together": ["dont-starve-together"],
    "barotrauma": ["barotrauma"],
    "necesse": ["necesse"],
    "aneurism-iv": ["aneurism-iv"],
    "wolfenstein-enemy-territory": ["wolfenstein-enemy-territory"],
    "openmohaa": ["openmohaa"],
    "unvanquished": ["unvanquished"],
    "battlefield-1942-anthology": ["battlefield-1942-anthology"],
    "re-volt-rvgl": ["re-volt-rvgl"],
    "morrowind": ["morrowind"],
    "freedoom": ["freedoom"],
    "bombsquad": ["bombsquad"],
    "veloren": ["veloren"],
    "ysoccer": ["ysoccer"],
    "triplea": ["triplea"],
    "warzone-2100": ["warzone-2100"],
    "trackmania": ["trackmania"],
    "freeciv": ["freeciv"],
    "space-station-14": ["space-station-14"],
    "hurry-curry": ["hurry-curry"],
    "mindustry": ["mindustry"],
    "openra": ["openra"],
    "openhv": ["openhv"],
    "combined-arms": ["combined-arms"],
    "earth-2140-trilogy": ["earth-2140-trilogy", "opene2140"],
    "hypersomnia": ["hypersomnia"],
    "assaultcube": ["assaultcube"],
    "factorio": ["factorio"],
    "terraria": ["terraria"],
    "bzflag": ["bzflag"],
    "hedgewars": ["hedgewars"],
    "openttd": ["openttd"],
    "luanti": ["luanti"],
    "battle-for-wesnoth": ["battle-for-wesnoth"],
    "rimworld-together": ["rimworld-together"],
    "flightgear": ["flightgear"],
    "teeworlds": ["teeworlds"],
    "0ad": ["0ad", "0-ad"],
    "xonotic": ["xonotic"],
    "supertuxkart": ["supertuxkart"],
    "openarena": ["openarena"],
}
if len(sys.argv) != 2 or sys.argv[1] not in targets:
    sys.exit(2)
roots = [os.path.realpath("/opt/playbound-host/games/" + folder) for folder in targets[sys.argv[1]]]
# The OS binary is not replaced by reviewed-native updates. A sandbox mounts
# the managed file over its OS path, so match its actual inode rather than
# incorrectly blocking on a separate, untouched system-package process.
native_identity = None
native_path = None
native_paths = {"bzflag": ("bzfs", "/usr/games/bzfs"), "hedgewars": ("hedgewars-server", "/usr/lib/hedgewars/bin/hedgewars-server"), "openttd": ("openttd", "/usr/games/openttd"), "luanti": ("minetestserver", "/usr/lib/minetest/minetestserver"), "teeworlds": ("teeworlds-server", "/usr/games/teeworlds-server")}
if sys.argv[1] in native_paths:
    binary, native_path = native_paths[sys.argv[1]]
    try:
        info = os.stat(roots[0] + "/" + binary)
        native_identity = (info.st_dev, info.st_ino)
    except FileNotFoundError:
        pass
if sys.argv[1] == "barotrauma":
    # The executable and cwd live in private copies, outside the shared depot.
    roots.extend(["/var/lib/playbound-host/barotrauma-servers", "/var/lib/playbound-host/barotrauma-servers-rooms"])
if sys.argv[1] == "aneurism-iv":
    roots.append("/var/lib/playbound-host/aneurism-iv-servers")
if sys.argv[1] == "trackmania":
    roots.extend(["/var/lib/playbound-host/trackmania-servers", "/var/lib/playbound-host/trackmania-servers-rooms"])
if sys.argv[1] == "mindustry":
    roots.append("/var/lib/playbound-host/mindustry")
if sys.argv[1] == "hypersomnia":
    roots.append("/var/lib/playbound-host/hypersomnia")
if sys.argv[1] == "open-fortress":
    roots.extend(["/var/lib/playbound-host/open-fortress-servers", "/var/lib/playbound-host/of-acceptance/open-fortress-servers"])
count = 0
if sys.argv[1] == "goldeneye-source":
    roots.extend(["/var/lib/playbound-host/goldeneye-source-servers", "/var/lib/playbound-host/goldeneye-source-servers-rooms", "/var/lib/playbound-host/ge-acceptance"])
if sys.argv[1] == "deus-ex":
    roots.extend(["/var/lib/playbound-host/deus-ex", "/var/lib/playbound-host/state/hx-query-review-TVmO31/deus-ex"])
try:
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        matched = False
        java_process = False
        for field in ("exe", "cwd"):
            try:
                value = os.readlink("/proc/" + entry + "/" + field).removesuffix(" (deleted)")
            except (FileNotFoundError, ProcessLookupError):
                continue
            # UID runtimes bind a sealed, copied engine over the system path.
            # Its inode differs from the shared installation. Hold every engine
            # at this fixed namespace path, including untouched system-package
            # servers, rather than miss an enrolled runtime during rollback.
            if sys.argv[1] == "teeworlds" and field == "exe" and value == "/usr/games/teeworlds-server":
                matched = True
            if field == "exe" and native_identity and value == native_path:
                try:
                    info = os.stat("/proc/" + entry + "/exe")
                    matched = matched or (info.st_dev, info.st_ino) == native_identity
                except (FileNotFoundError, ProcessLookupError):
                    continue
            if sys.argv[1] == "warzone-2100" and field == "exe" and value in ("/usr/bin/warzone2100", "/usr/bin/crashpad_handler_warzone2100"):
                matched = True
            if field == "exe" and os.path.basename(value) == "java":
                java_process = True
            if any(value == root or value.startswith(root + "/") for root in roots):
                matched = True
            # AppImage child executables run from a temporary FUSE mount rather
            # than the installation directory. Unclassified mounts hold the
            # queue conservatively; never inspect argv or interrupt a process.
            if sys.argv[1] in ("openhv", "earth-2140-trilogy", "hypersomnia", "romanovs-vengeance", "tiberian-dawn-hd", "crystallized-nexus") and any(
                part.startswith((".mount_", "appimage_extracted_")) for part in value.split("/")
            ):
                matched = True
        if sys.argv[1] in ("mindustry", "ysoccer", "triplea") and java_process and not matched:
            # A JVM can load this JAR from any cwd and then close its descriptor.
            # Without inspecting argv we cannot exclude it. Wait conservatively
            # for unclassified JVMs; never stop another game's Java process.
            matched = True
        if matched:
            count += 1
    print(json.dumps({"ok": True, "count": count}))
except OSError:
    print(json.dumps({"ok": False}))
    sys.exit(1)
