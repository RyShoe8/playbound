#!/usr/bin/python3
"""Root-owned read-only scan. Never inspect command lines or environments."""
import json
import os
import sys

targets = {
    "counter-strike-2": ["counter-strike-2", "cs2"],
    "team-fortress-2": ["team-fortress-2"],
    "unturned": ["unturned"],
    "counter-strike-source": ["counter-strike-source"],
    "core-keeper": ["core-keeper"],
    "dont-starve-together": ["dont-starve-together"],
    "barotrauma": ["barotrauma"],
    "necesse": ["necesse"],
    "mindustry": ["mindustry"],
    "openra": ["openra"],
    "openhv": ["openhv"],
    "earth-2140-trilogy": ["earth-2140-trilogy", "opene2140"],
    "hypersomnia": ["hypersomnia"],
    "assaultcube": ["assaultcube"],
    "factorio": ["factorio"],
    "terraria": ["terraria"],
}
if len(sys.argv) != 2 or sys.argv[1] not in targets:
    sys.exit(2)
roots = [os.path.realpath("/opt/playbound-host/games/" + folder) for folder in targets[sys.argv[1]]]
if sys.argv[1] == "barotrauma":
    # The executable and cwd live in private copies, outside the shared depot.
    roots.extend(["/var/lib/playbound-host/barotrauma-servers", "/var/lib/playbound-host/barotrauma-servers-rooms"])
if sys.argv[1] == "mindustry":
    roots.append("/var/lib/playbound-host/mindustry")
if sys.argv[1] == "hypersomnia":
    roots.append("/var/lib/playbound-host/hypersomnia")
count = 0
try:
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        matched = False
        java_process = False
        for field in ("exe", "cwd"):
            try:
                value = os.readlink("/proc/" + entry + "/" + field).removesuffix(" (deleted)")
            except (FileNotFoundError, ProcessLookupError):
                continue
            if field == "exe" and os.path.basename(value) == "java":
                java_process = True
            if any(value == root or value.startswith(root + "/") for root in roots):
                matched = True
            # AppImage child executables run from a temporary FUSE mount rather
            # than the installation directory. Unclassified mounts hold the
            # queue conservatively; never inspect argv or interrupt a process.
            if sys.argv[1] in ("openhv", "earth-2140-trilogy", "hypersomnia") and any(
                part.startswith((".mount_", "appimage_extracted_")) for part in value.split("/")
            ):
                matched = True
        if sys.argv[1] == "mindustry" and java_process and not matched:
            # A JVM can load this JAR from any cwd and then close its descriptor.
            # Without inspecting argv we cannot exclude it. Wait conservatively
            # for unclassified JVMs; never stop another game's Java process.
            matched = True
        if matched:
            count += 1
    print(json.dumps({"ok": True, "count": count}))
except OSError:
    print(json.dumps({"ok": False}))
    sys.exit(1)
